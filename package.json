{
  "name": "atlas-photo",
  "version": "0.1.0",
  "description": "A beautiful Atlas Photo gallery app with map integration, inspired by iOS Photos",
  "main": "dist-electron/main/index.js",
  "author": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "electron-vite dev",
    "electron:build": "electron-vite build",
    "electron:preview": "electron-vite preview",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "release:win": "electron-builder --win",
    "release:mac": "electron-builder --mac",
    "release:linux": "electron-builder --linux"
  },
  "dependencies": {
    "@luomus/leaflet-smooth-wheel-zoom": "^1.0.0",
    "@tanstack/react-query": "^5.101.2",
    "exifr": "^7.1.3",
    "heic-convert": "^2.1.0",
    "leaflet": "^1.9.4",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^0.427.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.26.1",
    "react-window": "^2.2.7",
    "sharp": "^0.33.4",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/heic-convert": "^2",
    "@types/leaflet": "^1.9.8",
    "@types/lodash": "^4.17.24",
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^30.0.9",
    "electron-builder": "^26.15.3",
    "electron-vite": "^1.0.28",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.35.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.40",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.6.2",
    "vite": "^4.5.0",
    "vitest": "^4.1.10"
  }
}
