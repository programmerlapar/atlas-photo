{
  "name": "atlas-photo",
  "version": "0.1.1",
  "description": "Atlas Photo: a privacy-first, offline desktop photo gallery app for Windows, macOS and Linux. Browse photos by location on an interactive GPS map with automatic EXIF metadata extraction. Built with Electron, React, and Vite.",
  "main": "dist-electron/main/index.js",
  "author": {
    "name": "Atlas Photo",
    "email": "pirmansah.otoluwa@gmail.com"
  },
  "desktopName": "Atlas Photo",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "electron-vite dev",
    "electron:build": "electron-vite build",
    "electron:preview": "electron-vite preview",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test": "vitest run",
    "test:packaged": "npm run electron:build && node scripts/packaged-smoke-test.mjs",
    "test:watch": "vitest",
    "release:win": "electron-builder --win",
    "release:mac": "electron-builder --mac",
    "release:linux": "electron-builder --linux"
  },
  "dependencies": {
    "@luomus/leaflet-smooth-wheel-zoom": "^1.0.0",
    "@tanstack/react-query": "^5.104.3",
    "exifr": "^7.1.3",
    "heic-convert": "^2.1.0",
    "leaflet": "^1.9.4",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.4",
    "react-window": "^2.3.4",
    "sharp": "^0.35.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/heic-convert": "^2",
    "@types/leaflet": "^1.9.22",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.35.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
